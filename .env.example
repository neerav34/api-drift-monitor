# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption (hosted-mode auth headers) — generate with: openssl rand -hex 32
AUTH_HEADER_ENCRYPTION_KEY=

# Public URL of this dashboard -- used to build links in alerts and badges.
# Self-hosted checkers authenticate via a per-API webhook_token generated in
# the dashboard when the API is added, not a shared secret here.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Alerts
SLACK_TEST_WEBHOOK_URL=

# Email alerts (Resend, free tier -- no card needed). Optional and additive
# alongside a Slack/Discord webhook, not a replacement for it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Deploy correlation
GITHUB_APP_TOKEN=

# LLM diff summaries (pick one free-tier provider)
GROQ_API_KEY=
GEMINI_API_KEY=

# Public /demo page -- id of a real API to showcase, read-only, no signup
# required. Leave blank to show a "no demo configured" message instead.
DEMO_API_ID=
