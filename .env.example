# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption (hosted-mode auth headers) — generate with: openssl rand -hex 32
AUTH_HEADER_ENCRYPTION_KEY=

# Public URL of this dashboard -- used to build links in alerts and badges.
# Self-hosted checkers authenticate via a per-API webhook_token generated in
# the dashboard when the API is added, not a shared secret here.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Alerts
SLACK_TEST_WEBHOOK_URL=

# Deploy correlation
GITHUB_APP_TOKEN=

# LLM diff summaries (pick one free-tier provider)
GROQ_API_KEY=
GEMINI_API_KEY=
